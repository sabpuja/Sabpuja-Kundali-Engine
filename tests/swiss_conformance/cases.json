{
  "schema": "sabpuja-swiss-conformance-cases/1",
  "note": "Predeclared synthetic cases. No real birth records. Time conversion here tests application of the installed IANA tzdb rules, not historical clock truth (RG-HIST remains a launch blocker). expected_utc values were derived by hand from the stated offsets.",
  "cases": [
    {
      "id": "SC-01",
      "purpose": "J2000.0 noon UTC, northern India coordinates",
      "request": {
        "birth_datetime": "2000-01-01T12:00:00+00:00",
        "timezone": "UTC",
        "latitude": 28.6139,
        "longitude": 77.209
      },
      "expect": "chart",
      "expected_utc": "2000-01-01T12:00:00Z",
      "expected_refusal": null
    },
    {
      "id": "SC-02",
      "purpose": "Local date after UTC date (IST morning is previous UTC day)",
      "request": {
        "birth_datetime": "2000-01-01T03:00:00+05:30",
        "timezone": "Asia/Kolkata",
        "latitude": 22.5726,
        "longitude": 88.3639
      },
      "expect": "chart",
      "expected_utc": "1999-12-31T21:30:00Z",
      "expected_refusal": null
    },
    {
      "id": "SC-03",
      "purpose": "Leap day 2024, IST evening",
      "request": {
        "birth_datetime": "2024-02-29T23:45:00+05:30",
        "timezone": "Asia/Kolkata",
        "latitude": 19.076,
        "longitude": 72.8777
      },
      "expect": "chart",
      "expected_utc": "2024-02-29T18:15:00Z",
      "expected_refusal": null
    },
    {
      "id": "SC-04",
      "purpose": "Leap day 2000 (century leap year), southern hemisphere",
      "request": {
        "birth_datetime": "2000-02-29T00:00:00+00:00",
        "timezone": "UTC",
        "latitude": -33.8688,
        "longitude": 151.2093
      },
      "expect": "chart",
      "expected_utc": "2000-02-29T00:00:00Z",
      "expected_refusal": null
    },
    {
      "id": "SC-05",
      "purpose": "DST fall-back, first 01:30 (EDT)",
      "request": {
        "birth_datetime": "2026-11-01T01:30:00-04:00",
        "timezone": "America/New_York",
        "latitude": 40.7128,
        "longitude": -74.006
      },
      "expect": "chart",
      "expected_utc": "2026-11-01T05:30:00Z",
      "expected_refusal": null
    },
    {
      "id": "SC-06",
      "purpose": "DST fall-back, second 01:30 (EST)",
      "request": {
        "birth_datetime": "2026-11-01T01:30:00-05:00",
        "timezone": "America/New_York",
        "latitude": 40.7128,
        "longitude": -74.006
      },
      "expect": "chart",
      "expected_utc": "2026-11-01T06:30:00Z",
      "expected_refusal": null
    },
    {
      "id": "SC-07",
      "purpose": "DST spring-forward gap: 02:30 does not exist; must be refused",
      "request": {
        "birth_datetime": "2026-03-08T02:30:00-05:00",
        "timezone": "America/New_York",
        "latitude": 40.7128,
        "longitude": -74.006
      },
      "expect": "refuse",
      "expected_utc": null,
      "expected_refusal": "INPUT_REFUSED"
    },
    {
      "id": "SC-08",
      "purpose": "Southern-hemisphere DST (AEDT)",
      "request": {
        "birth_datetime": "2026-01-15T20:00:00+11:00",
        "timezone": "Australia/Sydney",
        "latitude": -33.8688,
        "longitude": 151.2093
      },
      "expect": "chart",
      "expected_utc": "2026-01-15T09:00:00Z",
      "expected_refusal": null
    },
    {
