      "purpose": "Moon just below 360 sidereal (instant frozen from a search with the pinned binding)",
      "request": {
        "birth_datetime": "2026-10-25T13:52:19+00:00",
        "timezone": "UTC",
        "latitude": 0.0,
        "longitude": 0.0
