      "expected_refusal": "INPUT_REFUSED"
    },
    {
      "id": "SC-13",
      "purpose": "Local date 1900 but UTC 1899: refused by the current UTC-year check (SCI-03 local-date window pending)",
      "request": {
        "birth_datetime": "1900-01-01T02:00:00+03:00",
