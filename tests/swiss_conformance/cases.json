    {
      "id": "SC-17",
      "purpose": "Arctic: Placidus undefined; engine and swetest must both refuse the Placidus ascendant",
      "request": {
        "birth_datetime": "2026-06-21T12:00:00+00:00",
        "timezone": "UTC",
        "latitude": 70.0,
        "longitude": 25.0
      },
      "expect": "refuse",
      "expected_utc": null,
      "expected_refusal": "ASCENDANT_UNCOMPUTABLE"
    },
    {
      "id": "SC-18",
      "purpose": "Antarctic: as SC-17",
