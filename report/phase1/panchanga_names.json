  "def.karana": {
   "en": "Karana: half of a Tithi, 6° of E, so there are 60 in a lunar month. It is shown by its number, 1 to 60, and its name.",
   "hi": "करण: तिथि का आधा भाग, E के 6°, इसलिए चंद्र मास में 60 करण होते हैं। यहाँ इसका क्रमांक, 1 से 60, और नाम दिया गया है।"
  },
  "def.yoga": {
   "en": "Yoga: one of 27 spans of 13°20′ of the sum S of the sidereal Sun and Moon longitudes, shown by its number 1 to 27 and its name. It is not a planetary Yoga.",
   "hi": "योग: निरयन सूर्य और चंद्र भोगांशों के जोड़ S के 13°20′ के 27 खंडों में से एक, जिसका क्रमांक 1 से 27 और नाम दिया गया है। यह ग्रह-योग नहीं है।"
  }
 }
