 "strings": {
  "qa.subject": {
   "en": "QA PREVIEW, NOT FOR CUSTOMERS: Panchanga names pending review",
   "hi": "QA पूर्वावलोकन, ग्राहकों के लिए नहीं: पंचांग नाम समीक्षा के लिए लंबित"
  },
  "qa.notice": {
   "en": " QA PREVIEW, NOT FOR CUSTOMERS: the Tithi, Karana and Yoga names on these pages are pending human Hindi language and Jyotish terminology review.",
   "hi": " QA पूर्वावलोकन, ग्राहकों के लिए नहीं: इन पृष्ठों पर तिथि, करण और योग के नाम हिंदी भाषा और ज्योतिष शब्दावली की मानवीय समीक्षा के लिए लंबित हैं।"
  },
  "card.tithi_sub": {
   "en": "{name}, day {day} of 15",
   "hi": "{name}, पक्ष का दिन {day}"
  },
  "card.karana_sub": {
   "en": "{name}, {kind} Karana",
   "hi": "{name}, {kind} करण"
  },
  "card.yoga_sub": {
   "en": "{name}, Panchanga Yoga",
   "hi": "{name}, पंचांग योग"
  },
  "tr.karana_first": {
   "en": "{name}, 1st half",
   "hi": "{name}, पूर्वार्ध"
  },
  "tr.karana_second": {
   "en": "{name}, 2nd half",
   "hi": "{name}, उत्तरार्ध"
  },
  "pm.karana_value": {
   "en": "Number of whole 6° steps of E, plus 1 (1 to 60). Names follow the IMD Rashtriya Panchang: {first} at 1, the seven repeating Karanas {rep_first} to {rep_last} eight times from 2 to 57, then {k58}, {k59} and {k60}.",
   "hi": "E के पूरे 6° भागों की संख्या, धन 1 (1 से 60)। नाम IMD राष्ट्रीय पंचांग के अनुसार: 1 पर {first}, 2 से 57 तक सात चर करण {rep_first} से {rep_last} आठ बार, फिर {k58}, {k59} और {k60}।"
  },
  "pm.yoga_value": {
   "en": "S = (Sun + Moon) mod 360°. Yoga = number of whole 13°20′ steps of S, plus 1 (1 to 27), named in the IMD Rashtriya Panchang order from {first} to {last}.",
   "hi": "S = (सूर्य + चंद्र) mod 360°। योग = S के पूरे 13°20′ भागों की संख्या, धन 1 (1 से 27), IMD राष्ट्रीय पंचांग के क्रम में {first} से {last} तक नामित।"
  },
  "pm.inc1": {
   "en": "Tithi number and name, Paksha, day",
   "hi": "तिथि क्रमांक और नाम, पक्ष, दिन"
  },
  "pm.inc2": {
   "en": "Karana number and name",
   "hi": "करण क्रमांक और नाम"
  },
  "pm.inc3": {
   "en": "Yoga number and name",
   "hi": "योग क्रमांक और नाम"
  },
  "pm.exc3": {
   "en": "Reviewed, customer-approved names",
   "hi": "समीक्षित, ग्राहक-अनुमोदित नाम"
