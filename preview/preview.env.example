# EXAMPLE ONLY. Real secrets must be outside Git and readable only by operator.
SABPUJA_PREVIEW_EPHE_DIR=/absolute/path/to/approved/se1
SABPUJA_PREVIEW_NETWORK=edge
SABPUJA_PREVIEW_USER=unique-preview-user
# Generate bcrypt hash with: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'synthetic-password'
SABPUJA_PREVIEW_PASSWORD_HASH=replace-with-bcrypt-hash
SABPUJA_PREVIEW_ORIGIN=https://kundali-preview.sabpuja.com
