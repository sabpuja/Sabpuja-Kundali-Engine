# Example only: do not commit credentials or provide real customer records.
SABPUJA_PREVIEW_EPHE_DIR=/absolute/path/to/approved/se1
SABPUJA_PREVIEW_NETWORK=isolated-qa-network
# Make an outside-repository htpasswd file, readable by the Nginx user (UID 101)
# Hash credentials with openssl passwd -6 or an approved htpasswd utility.
# Never commit the file or the plaintext credential.
SABPUJA_PREVIEW_HTPASSWD_FILE=/absolute/private/path/client-preview.htpasswd
